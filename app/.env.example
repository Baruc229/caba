DATABASE_URL="postgresql://user:password@db.<ref>.supabase.co:5432/postgres?schema=public"

# NextAuth
AUTH_SECRET="change-this-to-a-random-secret"

# Brevo (email)
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="sender@example.com"
BREVO_SENDER_NAME="Caba Residence"

# Gmail (optionnel, relais d'email)
EMAIL_SERVER_PORT=465
EMAIL_SERVER_PASSWORD="app-password"
EMAIL_SERVER_USER="sender@gmail.com"

# Supabase Storage (upload d'images)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# Clé SERVICE ROLE : Dashboard Supabase > Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="coller-ici-la-cle-service-role"
